# Database / cache (matches docker-compose.yml)
DATABASE_URL=postgresql://gracetunes:gracetunes@localhost:5432/gracetunes?schema=public
REDIS_URL=redis://localhost:6379

# HTTP server
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Auth: use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=1h

# Seeded admin account (change before any shared deployment)
SEED_ADMIN_EMAIL=admin@gracetunes.local
SEED_ADMIN_PASSWORD=ChangeMe123
